# ============================================================
# Environment Variables — FinTech Sales Intelligence
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=FinTech Sales Intelligence
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key

# ---- Database (MySQL) ----
DATABASE_URL=mysql+asyncmy://fintech:fintech_secret@localhost:3306/fintech_sales
MYSQL_USER=fintech
MYSQL_PASSWORD=fintech_secret
MYSQL_DB=fintech_sales
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_secret

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- LLM Provider Selection ----
# Options: openai | deepseek | qwen | ollama
LLM_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Qwen (Alibaba Cloud / DashScope) ----
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Ollama (Local) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ---- Search Provider ----
# Options: serpapi | google | tavily
SEARCH_PROVIDER=tavily
SERPAPI_KEY=your-serpapi-key-here
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-custom-search-engine-id-here
TAVILY_API_KEY=your-tavily-api-key-here

# ---- Crawling ----
CRAWL_RATE_LIMIT=2
CRAWL_TIMEOUT=30
CRAWL_MAX_PAGES_PER_SITE=20
RESPECT_ROBOTS_TXT=true

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
